{
  "name": "echopilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript-first hands-free agent companion",
  "main": "dist/main/index.cjs",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package-local.mjs --cloud-voice",
    "package:test": "node --test scripts/package-local.test.mjs",
    "package:verify": "node scripts/qualify-local-app.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-project.mjs",
    "contracts:check": "pnpm --filter @echopilot/contracts check:generated",
    "check": "pnpm contracts:check && pnpm typecheck && pnpm test && pnpm build",
    "smoke": "node scripts/smoke.mjs",
    "smoke:voice": "node scripts/voice-smoke.mjs",
    "models:asr": "node scripts/vendor-asr.mjs",
    "models:vad": "node scripts/vendor-vad.mjs",
    "loop": "node scripts/loop.mjs",
    "loop:cmux": "LOOP_TERMINALS=cmux node scripts/loop.mjs",
    "loop:init": "node scripts/loop.mjs --initialize-only",
    "loop:retry": "node scripts/loop.mjs --retry-blocked",
    "loop:dry": "node scripts/loop.mjs --dry-run",
    "loop:self-test": "node scripts/loop.mjs --self-test",
    "loop:start": "node scripts/start-autonomous.mjs",
    "loop:policy-test": "node --test scripts/loop-gates.test.mjs scripts/loop-policy.test.mjs",
    "release:validate": "node scripts/validate-release.mjs",
    "progress:board": "node scripts/progress-board.mjs",
    "progress:task": "node scripts/progress-task.mjs",
    "models:wake": "node scripts/vendor-wake.mjs"
  },
  "dependencies": {
    "@sctg/sentencepiece-js": "1.3.3",
    "js-tiktoken": "1.0.21",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sherpa-onnx-node": "1.13.8",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "8.18.2",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
